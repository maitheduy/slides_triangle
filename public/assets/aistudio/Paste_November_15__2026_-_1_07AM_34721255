/* ============================================================
 * 22. TỰ KIỂM TRA (MỞ RỘNG)
 * ============================================================ */
function runSelfTests(){
  const out = [];
  const EPS = 1e-12;
  const eq = (u,v)=> Math.abs(u[0]-v[0])<EPS && Math.abs(u[1]-v[1])<EPS;
  const O=[0,0], A=[1,-1], B=[0,-1];
  const M=[0.5,-0.5], P=[0.5,-1], Q=[0,-0.5];

  // Ảnh các đỉnh tại α=β=0
  const cases = [
    ['f1(O)', MAPS[1](...O,0,0), O],
    ['f1(A)', MAPS[1](...A,0,0), Q],
    ['f1(B)', MAPS[1](...B,0,0), M],
    ['f2(O)', MAPS[2](...O,0,0), Q],
    ['f2(A)', MAPS[2](...A,0,0), B],
    ['f2(B)', MAPS[2](...B,0,0), P],
    ['f3(O)', MAPS[3](...O,0,0), M],
    ['f3(A)', MAPS[3](...A,0,0), P],
    ['f3(B)', MAPS[3](...B,0,0), A],
    ['f4(O)', MAPS[4](...O,0,0), P],
    ['f4(A)', MAPS[4](...A,0,0), M],
    ['f4(B)', MAPS[4](...B,0,0), Q],
  ];
  let ok = 0;
  for(const [name, got, exp] of cases){
    const pass = eq(got,exp);
    if(pass) ok++;
    out.push(`${pass?'✓':'✗'} ${name} = (${got[0].toFixed(4)},${got[1].toFixed(4)}) ${pass?'=':'≠'} (${exp[0]},${exp[1]})`);
  }

  // Số tam giác các mức
  for(const lv of [0,1,7]){
    const d = buildLevel(lv);
    const exp = Math.pow(4,lv);
    const pass = d.triangles.length===exp;
    if(pass) ok++;
    out.push(`${pass?'✓':'✗'} Mức ${lv}: ${d.triangles.length} tam giác ${pass?'=':'≠'} ${exp}`);
  }

  // Địa chỉ dài đúng
  {
    const d = buildLevel(3);
    const pass = d.triangles.every(t=>t.a.length===3);
    if(pass) ok++;
    out.push(`${pass?'✓':'✗'} Mức 3: mọi địa chỉ dài 3`);
    const set = new Set(d.triangles.map(t=>t.a));
    const pass2 = set.size === 64;
    if(pass2) ok++;
    out.push(`${pass2?'✓':'✗'} Mức 3: ${set.size} địa chỉ khác nhau (kỳ vọng 64)`);
  }

  // Thứ tự hợp thành
  {
    const a=0,b=0;
    const T0 = {v:[O.slice(),A.slice(),B.slice()], a:'', outer:0};
    const T12 = applyMapToTri(1, applyMapToTri(2, T0, a, b), a, b);
    const T21 = applyMapToTri(2, applyMapToTri(1, T0, a, b), a, b);
    const v12_O = T12.v[0];
    const v21_O = T21.v[0];
    const exp12 = MAPS[1](...MAPS[2](...O,0,0),0,0);
    const exp21 = MAPS[2](...MAPS[1](...O,0,0),0,0);
    const p1 = eq(v12_O, exp12);
    const p2 = eq(v21_O, exp21);
    if(p1) ok++;
    if(p2) ok++;
    out.push(`${p1?'✓':'✗'} Đỉnh O của mảnh 12 = f1(f2(O)) = (${exp12[0].toFixed(4)},${exp12[1].toFixed(4)})`);
    out.push(`${p2?'✓':'✗'} Đỉnh O của mảnh 21 = f2(f1(O)) = (${exp21[0].toFixed(4)},${exp21[1].toFixed(4)})`);
    const diff = Math.hypot(v12_O[0]-v21_O[0], v12_O[1]-v21_O[1]);
    out.push(`   (12 ≠ 21: khoảng cách = ${diff.toFixed(4)})`);

    const T123 = applyMapToTri(1, applyMapToTri(2, applyMapToTri(3, T0, a, b), a, b), a, b);
    const exp123 = MAPS[1](...MAPS[2](...MAPS[3](...O,0,0),0,0),0,0);
    const p3 = eq(T123.v[0], exp123);
    if(p3) ok++;
    out.push(`${p3?'✓':'✗'} Đỉnh O của mảnh 123 = f1(f2(f3(O)))`);
  }

  // Trọng tâm mảnh w = f_w(trọng tâm T)
  {
    const a=0,b=0;
    const G = [(O[0]+A[0]+B[0])/3, (O[1]+A[1]+B[1])/3];
    const d = buildLevel(3);
    let pass = true;
    for(const t of d.triangles){
      const gx = (t.v[0][0]+t.v[1][0]+t.v[2][0])/3;
      const gy = (t.v[0][1]+t.v[1][1]+t.v[2][1])/3;
      let p = G.slice();
      for(let i=t.a.length-1;i>=0;i--){
        p = MAPS[parseInt(t.a[i],10)](p[0],p[1],a,b);
      }
      if(Math.hypot(gx-p[0], gy-p[1]) > 1e-10){ pass=false; break; }
    }
    if(pass) ok++;
    out.push(`${pass?'✓':'✗'} Trọng tâm mảnh w = f_w(trọng tâm T) (mức 3)`);
  }

  // α chỉ thay đổi tịnh tiến f1; β chỉ thay đổi tịnh tiến f4
  {
    const Lpart = (i)=>{
      const v = [0.7,-0.3];
      const d1 = [MAPS[i](v[0],v[1],0,0)[0]-MAPS[i](0,0,0,0)[0],
                  MAPS[i](v[0],v[1],0,0)[1]-MAPS[i](0,0,0,0)[1]];
      const d2 = [MAPS[i](v[0],v[1],0.5,-0.3)[0]-MAPS[i](0,0,0.5,-0.3)[0],
                  MAPS[i](v[0],v[1],0.5,-0.3)[1]-MAPS[i](0,0,0.5,-0.3)[1]];
      return Math.hypot(d1[0]-d2[0], d1[1]-d2[1])<1e-12;
    };
    const p = [1,2,3,4].every(Lpart);
    if(p) ok++;
    out.push(`${p?'✓':'✗'} Phần tuyến tính không phụ thuộc α,β`);

    const v=[0.3,-0.2];
    const only_f1 = (
      eq(MAPS[2](v[0],v[1],0.5,0), MAPS[2](v[0],v[1],0,0)) &&
      eq(MAPS[3](v[0],v[1],0.5,0), MAPS[3](v[0],v[1],0,0)) &&
      eq(MAPS[4](v[0],v[1],0.5,0), MAPS[4](v[0],v[1],0,0)) &&
      !eq(MAPS[1](v[0],v[1],0.5,0), MAPS[1](v[0],v[1],0,0))
    );
    if(only_f1) ok++;
    out.push(`${only_f1?'✓':'✗'} α chỉ thay đổi vectơ tịnh tiến của f₁`);

    const only_f4 = (
      eq(MAPS[1](v[0],v[1],0,0.7), MAPS[1](v[0],v[1],0,0)) &&
      eq(MAPS[2](v[0],v[1],0,0.7), MAPS[2](v[0],v[1],0,0)) &&
      eq(MAPS[3](v[0],v[1],0,0.7), MAPS[3](v[0],v[1],0,0)) &&
      !eq(MAPS[4](v[0],v[1],0,0.7), MAPS[4](v[0],v[1],0,0))
    );
    if(only_f4) ok++;
    out.push(`${only_f4?'✓':'✗'} β chỉ thay đổi vectơ tịnh tiến của f₄`);
  }

  // KIỂM TRA CHẾ ĐỘ LIÊN KẾT (MỚI)
  {
    // alpha = 0 → beta = 0
    const p1 = Math.abs(0 + 0/3) < EPS;
    if(p1) ok++;
    out.push(`${p1?'✓':'✗'} α=0 → β=−α/3=0`);

    // alpha = 0.3 → beta ≈ -0.1
    const beta2 = -0.3/3;
    const p2 = Math.abs(beta2 - (-0.1)) < EPS;
    if(p2) ok++;
    out.push(`${p2?'✓':'✗'} α=0.3 → β=${beta2.toFixed(9)} ≈ −0.1`);

    // alpha = -0.6 → beta ≈ 0.2
    const beta3 = -(-0.6)/3;
    const p3 = Math.abs(beta3 - 0.2) < EPS;
    if(p3) ok++;
    out.push(`${p3?'✓':'✗'} α=−0.6 → β=${beta3.toFixed(9)} ≈ 0.2`);

    // alpha = 0.127 → beta = -0.127/3, không bị làm tròn
    const beta4 = -0.127/3;
    const p4 = Math.abs(beta4 - (-0.042333333333)) < 1e-9;
    if(p4) ok++;
    out.push(`${p4?'✓':'✗'} α=0.127 → β=${beta4.toFixed(12)} (không làm tròn thành −0.042)`);

    // Trong chế độ liên kết, |beta + alpha/3| < 10^-12
    const testAlpha = 0.456;
    const testBeta = -testAlpha/3;
    const p5 = Math.abs(testBeta + testAlpha/3) < EPS;
    if(p5) ok++;
    out.push(`${p5?'✓':'✗'} Liên kết: |β + α/3| = ${Math.abs(testBeta + testAlpha/3).toExponential(2)} < 10⁻¹²`);
  }

  // KIỂM TRA ĐIỂM TIẾP XÚC (MỚI)
  {
    const a = 0.3, b = -0.1; // β = −α/3
    const fix1 = [0, -1];
    const fix2 = [2*a/3, 0];
    const U = MAPS[4](fix1[0], fix1[1], a, b);
    const V = MAPS[2](fix2[0], fix2[1], a, b);
    
    // U = (β, -1/2)
    const p1 = Math.abs(U[0] - b) < EPS && Math.abs(U[1] - (-0.5)) < EPS;
    if(p1) ok++;
    out.push(`${p1?'✓':'✗'} U = f₄(fix₁) = (${U[0].toFixed(6)}, ${U[1].toFixed(6)}) = (β, −1/2)`);
    
    // V = (-α/3, -1/2)
    const p2 = Math.abs(V[0] - (-a/3)) < EPS && Math.abs(V[1] - (-0.5)) < EPS;
    if(p2) ok++;
    out.push(`${p2?'✓':'✗'} V = f₂(fix₂) = (${V[0].toFixed(6)}, ${V[1].toFixed(6)}) = (−α/3, −1/2)`);
    
    // U = V khi β = −α/3
    const dist = Math.hypot(U[0]-V[0], U[1]-V[1]);
    const p3 = dist < EPS;
    if(p3) ok++;
    out.push(`${p3?'✓':'✗'} Khi β=−α/3: ||U−V|| = ${dist.toExponential(2)} < 10⁻¹² (trùng nhau)`);
    
    // Khi β ≠ −α/3, U ≠ V
    const a2 = 0.3, b2 = 0; // β ≠ −α/3
    const U2 = MAPS[4](fix1[0], fix1[1], a2, b2);
    const V2 = MAPS[2]