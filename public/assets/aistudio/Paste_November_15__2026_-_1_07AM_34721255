/* ============================================================
 * 16. CẬP NHẬT THAM SỐ TẬP TRUNG (MỚI)
 * ============================================================ */
function updateAlpha(newAlpha){
  STATE.alpha = newAlpha;
  if(STATE.linkedMode){
    STATE.beta = -newAlpha / 3;
    // Cập nhật UI beta nhưng không kích hoạt sự kiện
    const betaSlider = document.getElementById('beta');
    const betaNum = document.getElementById('betaNum');
    betaSlider.value = STATE.beta;
    betaNum.value = STATE.beta.toFixed(9);
  }
  markDirty();
}

function updateBeta(newBeta){
  if(STATE.linkedMode) return; // Không cho phép sửa beta khi đang liên kết
  STATE.beta = newBeta;
  markDirty();
}

function toggleLinkedMode(checked){
  STATE.linkedMode = checked;
  const betaSlider = document.getElementById('beta');
  const betaNum = document.getElementById('betaNum');
  const betaHint = document.getElementById('betaHint');
  
  if(checked){
    // Bật liên kết: tính beta từ alpha
    betaSlider.disabled = true;
    betaNum.disabled = true;
    betaSlider.step = 'any';
    betaNum.step = 'any';
    betaHint.style.display = 'inline';
    STATE.beta = -STATE.alpha / 3;
    betaSlider.value = STATE.beta;
    betaNum.value = STATE.beta.toFixed(9);
  } else {
    // Tắt liên kết: cho phép sửa độc lập
    betaSlider.disabled = false;
    betaNum.disabled = false;
    betaSlider.step = '0.001';
    betaNum.step = '0.001';
    betaHint.style.display = 'none';
  }
  markDirty();
}

function markDirty(){
  STATE.dirty = true;
  // Hủy tác vụ cũ
  cancelAllTasks();
  // Vô hiệu hóa cache
  STATE.chaosData = null;
  STATE.triData = null;
  STATE.selectedPiece = null;
  document.getElementById('pieceInfo').style.display='none';
  
  document.getElementById('paramState').style.display='block';
  updateStatus();
  
  if(document.getElementById('autoUpdate').checked){
    clearTimeout(STATE.autoTimer);
    STATE.autoTimer = setTimeout(()=>{
      if(STATE.mode==='chaos') startChaos();
      else setLevel(parseInt(document.getElementById('level').value,10));
    }, 350);
  }
}

/* ============================================================
 * 17. RÀNG BUỘC UI: slider ↔ number
 * ============================================================ */
function bindRangeNumber(rangeId, numId, onChange){
  const r = document.getElementById(rangeId);
  const n = document.getElementById(numId);
  let updating = false; // Cờ tránh vòng lặp
  
  r.addEventListener('input', ()=>{
    if(updating) return;
    updating = true;
    n.value = r.value;
    onChange(parseFloat(r.value));
    updating = false;
  });
  
  n.addEventListener('input', ()=>{
    if(updating) return;
    updating = true;
    let v = parseFloat(n.value);
    if(isNaN(v)){ updating = false; return; }
    v = Math.max(parseFloat(r.min), Math.min(parseFloat(r.max), v));
    r.value = v; n.value = v;
    onChange(v);
    updating = false;
  });
  
  n.addEventListener('change', ()=>{
    if(updating) return;
    updating = true;
    let v = parseFloat(n.value);
    if(isNaN(v)) v = parseFloat(r.value);
    v = Math.max(parseFloat(r.min), Math.min(parseFloat(r.max), v));
    r.value = v; n.value = v;
    onChange(v);
    updating = false;
  });
}

