  s += ` · Chế độ: <b>${STATE.mode==='chaos'?'Chaos game':'Tam giác từng mức'}</b>`;
  
  if(STATE.mode==='chaos' && STATE.chaosData){
    s += ` · Seed: <b>${document.getElementById('seed').value}</b> · Điểm: <b>${STATE.chaosData.n.toLocaleString('vi-VN')}</b>`;
    if(STATE.chaosData.alpha!==a || STATE.chaosData.beta!==b){
      s += ` · <span class="warn">Tham số đã thay đổi — bấm Vẽ để cập nhật.</span>`;
    }
  } else if(STATE.mode==='tri' && STATE.triData){
    s += ` · Mức: <b>${STATE.triData.level}</b> · Tam giác: <b>${STATE.triData.triangles.length.toLocaleString('vi-VN')}</b>`;
    if(STATE.triData.alpha!==a || STATE.triData.beta!==b){
      s += ` · <span class="warn">Tham số đã thay đổi — bấm Vẽ để cập nhật.</span>`;
    }
  }
  bar.innerHTML = s;
  document.getElementById('paramState').style.display='none';
