/* ============================================================
 * 18. KHUNG NHÌN: PAN / ZOOM
 * ============================================================ */
function fitView(){
  let xs=[], ys=[];
  if(STATE.mode==='chaos' && STATE.chaosData){
    const p = STATE.chaosData.points;
    const step = Math.max(1, Math.floor(p.length/3/5000));
    for(let i=0;i<p.length;i+=3*step){
      xs.push(p[i]); ys.push(p[i+1]);
    }
  } else if(STATE.mode==='tri' && STATE.triData){
    for(const t of STATE.triData.triangles){
      for(const v of t.v){ xs.push(v[0]); ys.push(v[1]); }
    }
  }
  if(xs.length===0){
    const R = safeRadius(STATE.alpha, STATE.beta);
    xs=[-R,R]; ys=[-R,R];
  }
  const xmin=Math.min(...xs), xmax=Math.max(...xs);
  const ymin=Math.min(...ys), ymax=Math.max(...ys);
  const cx=(xmin+xmax)/2, cy=(ymin+ymax)/2;
  const dx = Math.max(1e-6, xmax-xmin);
  const dy = Math.max(1e-6, ymax-ymin);
  const pad = 1.08;
  const scale = Math.min(W/(dx*pad), H/(dy*pad));
  STATE.view = {cx, cy, scale};
  redraw();
}

function safeInitialView(){
  const R = safeRadius(STATE.alpha, STATE.beta);
  const pad = 1.1;
  const scale = Math.min(W/(2*R*pad), H/(2*R*pad));
  STATE.view = {cx:0.25, cy:-0.5, scale};
  const sFit = Math.min(W/(2*R*pad), H/(2*R*pad));
  STATE.view.scale = Math.min(scale*1.2, sFit);
}

/* ============================================================
 * 19. TƯƠNG TÁC: kéo, zoom, chạm, chọn mảnh
 * ============================================================ */
cv.addEventListener('mousedown', (e)=>{
  STATE.dragging = true;
  STATE.lastX = e.clientX; STATE.lastY = e.clientY;
  STATE._moved = 0;
});
window.addEventListener('mousemove', (e)=>{
  if(!STATE.dragging) return;
  const dx = e.clientX - STATE.lastX;
  const dy = e.clientY - STATE.lastY;
  STATE._moved += Math.abs(dx)+Math.abs(dy);
  STATE.view.cx -= dx/STATE.view.scale;
  STATE.view.cy += dy/STATE.view.scale;
  STATE.lastX = e.clientX; STATE.lastY = e.clientY;
  redraw();
});
window.addEventListener('mouseup', (e)=>{
  if(STATE.dragging && STATE._moved < 4){
    handleClick(e.offsetX, e.offsetY);
  }
  STATE.dragging = false;
});

cv.addEventListener('wheel', (e)=>{
  e.preventDefault();
  const [wx,wy] = screenToWorld(e.offsetX, e.offsetY);
  const factor = Math.exp(-e.deltaY*0.0015);
  STATE.view.scale *= factor;
  STATE.view.cx = wx - (e.offsetX - W/2)/STATE.view.scale;
  STATE.view.cy = wy + (e.offsetY - H/2)/STATE.view.scale;
  redraw();
}, {passive:false});

let touches0 = null;
cv.addEventListener('touchstart', (e)=>{
  if(e.touches.length===1){
    STATE.dragging = true;
    STATE.lastX = e.touches[0].clientX;
    STATE.lastY = e.touches[0].clientY;
    STATE._moved = 0;
  } else if(e.touches.length===2){
    STATE.dragging = false;
    const t0 = e.touches[0], t1 = e.touches[1];
    STATE.pinchDist = Math.hypot(t1.clientX-t0.clientX, t1.clientY-t0.clientY);
    STATE.pinchCx = (t0.clientX+t1.clientX)/2;
    STATE.pinchCy = (t0.clientY+t1.clientY)/2;
  }
}, {passive:true});
cv.addEventListener('touchmove', (e)=>{
  if(e.touches.length===1 && STATE.dragging){
    const dx = e.touches[0].clientX - STATE.lastX;
    const dy = e.touches[0].clientY - STATE.lastY;
    STATE._moved += Math.abs(dx)+Math.abs(dy);
    STATE.view.cx -= dx/STATE.view.scale;
    STATE.view.cy += dy/STATE.view.scale;
    STATE.lastX = e.touches[0].clientX;
    STATE.lastY = e.touches[0].clientY;
    redraw();
  } else if(e.touches.length===2){
    const t0 = e.touches[0], t1 = e.touches[1];
    const d = Math.hypot(t1.clientX-t0.clientX, t1.clientY-t0.clientY);
    const cx = (t0.clientX+t1.clientX)/2;
    const cy = (t0.clientY+t1.clientY)/2;
    const rect = cv.getBoundingClientRect();
    const ox = cx - rect.left, oy = cy - rect.top;
    const [wx,wy] = screenToWorld(ox, oy);
    const factor = d/STATE.pinchDist;
    STATE.view.scale *= factor;
    STATE.view.cx = wx - (ox - W/2)/STATE.view.scale;
    STATE.view.cy = wy + (oy - H/2)/STATE.view.scale;
    STATE.pinchDist = d;
    redraw();
  }
  e.preventDefault();
}, {passive:false});
cv.addEventListener('touchend', (e)=>{
  if(STATE.dragging && STATE._moved < 8 && e.changedTouches.length===1){
    const rect = cv.getBoundingClientRect();
    const ox = e.changedTouches[0].clientX - rect.left;
    const oy = e.changedTouches[0].clientY - rect.top;
    handleClick(ox, oy);
  }
  STATE.dragging = false;
});

/* ============================================================
 * 20. CHỌN MẢNH
 * ============================================================ */
function pointInTri(px,py, v0,v1,v2){
  const d1 = sign(px,py,v0,v1);
  const d2 = sign(px,py,v1,v2);
  const d3 = sign(px,py,v2,v0);
  const hasNeg = (d1<0)||(d2<0)||(d3<0);
  const hasPos = (d1>0)||(d2>0)||(d3>0);
  return !(hasNeg && hasPos);
}
function sign(px,py, a,b){
  return (px-b[0])*(a[1]-b[1]) - (a[0]-b[0])*(py-b[1]);
}

function handleClick(ox, oy){
  if(STATE.mode!=='tri' || !STATE.triData) return;
  const [wx,wy] = screenToWorld(ox,oy);
  const hits = [];
  for(const t of STATE.triData.triangles){
    if(pointInTri(wx,wy, t.v[0], t.v[1], t.v[2])) hits.push(t);
  }
  showPieceInfo(hits);
  redraw();
}

function showPieceInfo(hits){
  const box = document.getElementById('pieceInfo');
  const c = document.getElementById('pieceContent');
  if(hits.length===0){ box.style.display='none'; return; }
  let html = '';
  for(const t of hits){
    const gx = (t.v[0][0]+t.v[1][0]+t.v[2][0])/3;
    const gy = (t.v[0][1]+t.v[1][1]+t.v[2][1])/3;
    const comp = compositionText(t.a);
    html += `<div style="margin-bottom:8px;border-bottom:1px dashed #2a3040;padding-bottom:6px">
      <div class="addr">Địa chỉ ${t.a||'∅'}: ${comp}</div>
      <div>V0 = (${t.v[0][0].toFixed(4)}, ${t.v[0][1].toFixed(4)})</div>
      <div>V1 = (${t.v[1][0].toFixed(4)}, ${t.v[1][1].toFixed(4)})</div>
      <div>V2 = (${t.v[2][0].toFixed(4)}, ${t.v[2][1].toFixed(4)})</div>
      <div>Trọng tâm = (${gx.toFixed(4)}, ${gy.toFixed(4)})</div>
    </div>`;
  }
  c.innerHTML = html;
  box.style.display='block';
  STATE.selectedPiece = hits[0].a;
}
function compositionText(addr){
  if(!addr) return 'T';
  const parts = addr.split('').map(c=>`f<sub>${c}</sub>`);
  let s = parts[0] + '(';
  for(let i=1;i<parts.length;i++) s += parts[i] + '(';
  s += 'T';
  for(let i=0;i<parts.length;i++) s += ')';
  return s;
}
