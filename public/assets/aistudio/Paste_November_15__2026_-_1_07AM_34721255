<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
<title>Phòng thí nghiệm IFS affine — họ hai tham số</title>
<style>
  :root{
    --bg:#0f1115; --panel:#171a21; --panel2:#1f2430; --ink:#e7ecf3;
    --muted:#9aa3b2; --accent:#5aa6ff; --warn:#ffb454; --ok:#63d18a;
    --c1:#ff6b6b; --c2:#4dd0e1; --c3:#ffd166; --c4:#a78bfa;
    --border:#2a3040;
  }
  *{box-sizing:border-box}
  html,body{margin:0;padding:0;background:var(--bg);color:var(--ink);
    font-family:system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;}
  header{padding:10px 14px;background:var(--panel);border-bottom:1px solid var(--border);
    display:flex;flex-wrap:wrap;gap:8px;align-items:center;justify-content:space-between}
  header h1{font-size:16px;margin:0;font-weight:600}
  header .tag{font-size:12px;color:var(--muted)}
  main{display:grid;grid-template-columns:340px 1fr;gap:0;min-height:calc(100vh - 50px)}
  @media (max-width: 900px){ main{grid-template-columns:1fr} }
  aside{background:var(--panel);border-right:1px solid var(--border);padding:12px;
    overflow-y:auto;max-height:calc(100vh - 50px)}
  .section{background:var(--panel2);border:1px solid var(--border);border-radius:8px;
    padding:10px;margin-bottom:10px}
  .section h3{margin:0 0 8px 0;font-size:13px;color:var(--accent);letter-spacing:.3px}
  .row{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:6px 0}
  .row label{font-size:12px;color:var(--muted);min-width:60px}
  input[type=range]{flex:1;min-width:120px}
  input[type=number]{width:82px;background:#0b0e13;color:var(--ink);
    border:1px solid var(--border);border-radius:4px;padding:4px 6px;font-size:12px}
  input[type=text]{width:100px;background:#0b0e13;color:var(--ink);
    border:1px solid var(--border);border-radius:4px;padding:4px 6px;font-size:12px}
  input:disabled{opacity:.5;cursor:not-allowed}
  button{background:#243047;color:var(--ink);border:1px solid var(--border);
    border-radius:6px;padding:6px 10px;font-size:12px;cursor:pointer}
  button:hover{background:#2d3c58}
  button.primary{background:#2b5ea8;border-color:#3a78cf}
  button.primary:hover{background:#3570c2}
  button.danger{background:#6b2a2a;border-color:#8a3535}
  button.warn{background:#6b4a1e;border-color:#8a6230}
  button:disabled{opacity:.5;cursor:not-allowed}
  .tabs{display:flex;gap:4px;margin-bottom:8px}
  .tab{flex:1;padding:6px;text-align:center;background:#1a2030;border:1px solid var(--border);
    border-radius:6px;cursor:pointer;font-size:12px;color:var(--muted)}
  .tab.active{background:#2b5ea8;color:#fff;border-color:#3a78cf}
  .legend{display:flex;gap:10px;flex-wrap:wrap;font-size:12px}
  .sw{display:inline-block;width:12px;height:12px;border-radius:2px;vertical-align:middle;margin-right:4px}
  #canvasWrap{position:relative;background:#0a0c10;overflow:hidden}
  canvas{display:block;width:100%;height:100%;cursor:grab;touch-action:none}
  canvas:active{cursor:grabbing}
  #statusBar{position:absolute;left:8px;bottom:8px;background:rgba(20,24,32,.85);
    border:1px solid var(--border);border-radius:6px;padding:6px 10px;font-size:11px;
    color:var(--muted);max-width:calc(100% - 16px);line-height:1.45}
  #statusBar b{color:var(--ink)}
  #progressWrap{position:absolute;left:8px;right:8px;top:8px;display:none}
  #progressBar{height:6px;background:#1a2030;border-radius:3px;overflow:hidden;border:1px solid var(--border)}
  #progressFill{height:100%;background:var(--accent);width:0%}
  #progressLabel{font-size:11px;color:var(--muted);margin-top:4px}
  #pieceInfo{position:absolute;right:8px;top:8px;background:rgba(20,24,32,.92);
    border:1px solid var(--border);border-radius:6px;padding:8px 10px;font-size:11px;
    max-width:320px;display:none;line-height:1.5}
  #pieceInfo .addr{color:var(--accent);font-weight:600;font-size:13px}
  #pieceInfo .close{float:right;cursor:pointer;color:var(--muted)}
  .chk{display:flex;gap:6px;align-items:center;font-size:12px;color:var(--ink)}
  .chk input{margin:0}
  .formula{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px;
    background:#0b0e13;border:1px solid var(--border);border-radius:6px;padding:8px;
    white-space:pre-wrap;line-height:1.55}
  .note{font-size:11px;color:var(--muted);line-height:1.5;background:#151925;
    border:1px dashed var(--border);border-radius:6px;padding:8px}
  .warn{color:var(--warn)}
  .ok{color:var(--ok)}
  #testBox{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:11px;
    background:#0b0e13;border:1px solid var(--border);border-radius:6px;padding:8px;
    max-height:180px;overflow-y:auto;line-height:1.5}
  .zoomBtns{position:absolute;right:8px;bottom:8px;display:flex;flex-direction:column;gap:4px}
  .zoomBtns button{width:36px;height:36px;font-size:16px;padding:0}
  .linked-hint{font-size:10px;color:var(--muted);margin-left:4px;font-style:italic}
</style>
</head>
<body>

<header>
  <h1>Phòng thí nghiệm IFS affine — họ hai tham số</h1>
  <span class="tag">Canvas 2D · Không CDN · Không backend · α,β ∈ [−1,1]</span>
</header>

<main>
  <aside>
    <!-- Chế độ -->
    <div class="section">
      <h3>Chế độ vẽ</h3>
      <div class="tabs">
        <div class="tab active" data-mode="chaos">Attractor — Chaos game</div>
        <div class="tab" data-mode="tri">Xấp xỉ tam giác — từng mức</div>
      </div>

      <!-- Chaos -->
      <div id="chaosPanel">
        <div class="row">
          <label>Số điểm</label>
          <input type="range" id="numPts" min="10000" max="1000000" step="10000" value="300000" />
          <input type="number" id="numPtsNum" min="10000" max="1000000" step="10000" value="300000" />
        </div>
        <div class="row">
          <label>Seed</label>
          <input type="text" id="seed" value="20261115" />
          <button id="newSeed">Seed mới</button>
        </div>
        <div class="row">
          <div class="chk"><input type="radio" name="colorMode" id="cmMono" checked><label for="cmMono">Một màu</label></div>
          <div class="chk"><input type="radio" name="colorMode" id="cmMap"><label for="cmMap">Theo ánh xạ</label></div>
        </div>
        <div class="row">
          <button class="primary" id="drawChaos">Vẽ attractor</button>
          <button class="danger" id="cancelTask">Hủy vẽ</button>
        </div>
        <div class="note">Ảnh xấp xỉ attractor bằng lấy mẫu ngẫu nhiên hữu hạn — không phải ảnh chính xác tuyệt đối.</div>
      </div>

      <!-- Tam giác -->
      <div id="triPanel" style="display:none">
        <div class="row">
          <label>Mức n</label>
          <input type="range" id="level" min="0" max="7" step="1" value="0" />
          <input type="number" id="levelNum" min="0" max="7" step="1" value="0" />
        </div>
        <div class="row" style="font-size:12px;color:var(--muted)">
          <span id="triCount">Số tam giác: 1</span>
        </div>
        <div class="row">
          <button id="prevLevel">◀ Bước trước</button>
          <button id="nextLevel">Bước tiếp ▶</button>
        </div>
        <div class="row">
          <button id="drawL7">Vẽ ngay mức 7</button>
          <button class="warn" id="autoRun">Tự chạy đến mức 7</button>
          <button class="danger" id="stopRun">Dừng</button>
        </div>
        <div class="row">
          <div class="chk"><input type="checkbox" id="showStroke" /><label for="showStroke">Viền tam giác</label></div>
        </div>
        <div class="note">Tₙ = f₁(Tₙ₋₁) ∪ f₂(Tₙ₋₁) ∪ f₃(Tₙ₋₁) ∪ f₄(Tₙ₋₁). Liệt kê cả mảnh trùng (nếu có). Với tham số tổng quát, không được giả định Tₙ lồng nhau hoặc các tam giác con không chồng lấn.</div>
      </div>
    </div>

    <!-- Tham số -->
    <div class="section">
      <h3>Tham số α, β</h3>
      <div class="row">
        <div class="chk"><input type="checkbox" id="linkBeta" checked /><label for="linkBeta">Liên kết β = −α/3</label></div>
      </div>
      <div class="row">
        <label>α</label>
        <input type="range" id="alpha" min="-1" max="1" step="0.001" value="0" />
        <input type="number" id="alphaNum" step="0.001" value="0" />
      </div>
      <div class="row">
        <label>β</label>
        <input type="range" id="beta" min="-1" max="1" step="0.001" value="0" />
        <input type="number" id="betaNum" step="0.001" value="0" />
        <span class="linked-hint" id="betaHint">Tự động theo β = −α/3</span>
      </div>
      <div class="row">
        <button id="resetParams">Đặt α=β=0</button>
        <button id="fitView">Vừa khung hình</button>
        <button id="clearView">Xóa hình</button>
        <button id="savePng">Tải PNG</button>
      </div>
      <div class="row">
        <div class="chk"><input type="checkbox" id="autoUpdate" /><label for="autoUpdate">Tự cập nhật (debounce)</label></div>
      </div>
      <div id="paramState" class="note" style="display:none">Tham số đã thay đổi — bấm <b>Vẽ</b> để cập nhật.</div>
    </div>

    <!-- Hiển thị -->
    <div class="section">
      <h3>Hiển thị</h3>
      <div class="row">
        <div class="chk"><input type="checkbox" id="showAxes" checked /><label for="showAxes">Trục tọa độ</label></div>
        <div class="chk"><input type="checkbox" id="showGrid" checked /><label for="showGrid">Lưới</label></div>
        <div class="chk"><input type="checkbox" id="showOrig" checked /><label for="showOrig">Tam giác OAB</label></div>
      </div>
      <div class="row">
        <div class="chk"><input type="checkbox" id="showLabels" checked /><label for="showLabels">Hiện địa chỉ các mảnh</label></div>
        <div class="chk"><input type="checkbox" id="autoHideLabels" checked /><label for="autoHideLabels">Tự ẩn nhãn quá nhỏ</label></div>
      </div>
      <div class="row">
        <label>Cỡ chữ</label>
        <input type="number" id="labelSize" min="6" max="32" step="1" value="12" />
        <span style="font-size:11px;color:var(--muted)" id="labelStats"></span>
      </div>
      <div class="row">
        <div class="chk"><input type="checkbox" id="showContact" /><label for="showContact">Hiện cặp điểm tiếp xúc</label></div>
      </div>
    </div>

    <!-- Chú giải -->
    <div class="section">
      <h3>Chú giải</h3>
      <div class="legend">
        <span><span class="sw" style="background:var(--c1)"></span>f₁</span>
        <span><span class="sw" style="background:var(--c2)"></span>f₂</span>
        <span><span class="sw" style="background:var(--c3)"></span>f₃</span>
        <span><span class="sw" style="background:var(--c4)"></span>f₄</span>
      </div>
    </div>

    <!-- Công thức -->
    <div class="section">
      <h3>Bốn ánh xạ</h3>
      <div class="formula" id="formulaBox"></div>
    </div>

    <!-- Ý nghĩa toán học -->
    <div class="section">
      <h3>Ý nghĩa của β = −α/3</h3>
      <div class="note">
        Quan hệ β = −α/3 bảo đảm hai điểm có địa chỉ <b>4(23)∞</b> và <b>21∞</b> trùng nhau. Đây là điều kiện tiếp xúc của cặp điểm được chọn; <span class="warn">chưa phải chứng minh OSC hoặc tính disk-like của toàn bộ attractor</span>.<br/><br/>
        <b>Chứng minh:</b><br/>
        • fix₁ = điểm cố định của f₂∘f₃ = (0, −1)<br/>
        • fix₂ = điểm cố định của f₁ = (2α/3, 0)<br/>
        • U = f₄(fix₁) = (β, −1/2)<br/>
        • V = f₂(fix₂) = (−α/3, −1/2)<br/>
        • U = V ⟺ β = −α/3<br/><br/>
        Trong địa chỉ: (23)∞ nghĩa là 232323..., 1∞ nghĩa là 111111... Chữ số bên trái là ánh xạ ngoài cùng.
      </div>
    </div>

    <!-- Tự kiểm tra -->
    <div class="section">
      <h3>Tự kiểm tra</h3>
      <div id="testBox">Đang chạy…</div>
    </div>

    <!-- Ghi chú khoa học -->
    <div class="section">
      <h3>Giới hạn khoa học</h3>
      <div class="note">
        Hình ảnh phục vụ khảo sát và hình thành giả thuyết. Quan sát bằng mắt <b>không chứng minh</b> điều kiện tập mở (OSC), tính đồng phôi với đĩa đóng, hay tính lát phủ.<br/>
        Không tự động kết luận OSC đúng chỉ vì hình nhìn không chồng lấn; không đồng nhất OSC với disk-like; không khẳng định mọi α,β tạo attractor có nội thất; không khẳng định đã tìm được lớp tiling mới; không hiển thị nhãn "Lean verified".<br/>
        <span class="ok">Tại α = β = 0, hệ trở về trường hợp tam giác OAB đã được nghiên cứu trong RC-000002-RIS-MO.</span>
      </div>
    </div>
  </aside>

  <div id="canvasWrap">
    <canvas id="cv"></canvas>
    <div id="progressWrap">
      <div id="progressBar"><div id="progressFill"></div></div>
      <div id="progressLabel"></div>
    </div>
    <div id="statusBar">Sẵn sàng.</div>
    <div id="pieceInfo">
      <span class="close" id="closePiece">✕</span>
      <div id="pieceContent"></div>
    </div>
    <div class="zoomBtns">
      <button id="zoomIn" title="Phóng to">+</button>
      <button id="zoomOut" title="Thu nhỏ">−</button>
      <button id="zoomFit" title="Vừa khung">⊙</button>
    </div>
  </div>
</main>

<script>
/* ============================================================
 * 0. CẤU HÌNH & TRẠNG THÁI TOÀN CỤC
 * ============================================================ */
const CFG = {
  O:[0,0], A:[1,-1], B:[0,-1],
  L:[[-1/2,-1/2],[0,1/2]],
  t: {
    1: (a,b)=>[a,0],
    2: (a,b)=>[0,-1/2],
    3: (a,b)=>[1/2,-1/2],
    4: (a,b)=>[1/2+b,-1]
  },
  q: (1+Math.sqrt(5))/4,
  colors: {1:'#ff6b6b',2:'#4dd0e1',3:'#ffd166',4:'#a78bfa'},
  mono: '#c9d4e6'
};

const STATE = {
  mode:'chaos',
  alpha:0, beta:0,
  linkedMode:true,  // MỚI: chế độ liên kết β = −α/3
  showContact:false, // MỚI: hiện cặp điểm tiếp xúc
  view:{cx:0.25, cy:-0.5, scale:400},
  chaosData:null,
  triData:null,
  taskId:0,
  autoTimer:null,
  dirty:true,
  showLabels:true, autoHideLabels:true, labelSize:12,
  selectedPiece:null,
  showAxes:true, showGrid:true, showOrig:true, showStroke:false,
  dragging:false, lastX:0, lastY:0,
  pinchDist:0, pinchCx:0, pinchCy:0
};

/* ============================================================
 * 1. TOÁN HỌC: 4 ÁNH XẠ (NGUỒN DUY NHẤT)
 * ============================================================ */
const MAPS = {
  1:(x,y,a,b)=>[-(x+y)/2 + a, y/2],
  2:(x,y,a,b)=>[-(x+y)/2,     y/2 - 1/2],
  3:(x,y,a,b)=>[-(x+y)/2 + 1/2, y/2 - 1/2],
  4:(x,y,a,b)=>[(x+y)/2 + 1/2 + b, -y/2 - 1]
};

function applyMap(i, v, a, b){ return MAPS[i](v[0], v[1], a, b); }

function applyMapToTri(i, tri, a, b){
  return {
    v: [applyMap(i,tri.v[0],a,b), applyMap(i,tri.v[1],a,b), applyMap(i,tri.v[2],a,b)],
    a: String(i) + tri.a,
    outer: i
  };
}

/* ============================================================
 * 2. RNG CÓ SEED (mulberry32)
 * ============================================================ */
function mulberry32(seed){
  let t = seed >>> 0;
  return function(){
    t = (t + 0x6D2B79F5) >>> 0;
    let r = t;
    r = Math.imul(r ^ (r >>> 15), 1 | t);
    r = r ^ (r + Math.imul(r ^ (r >>> 7), 61 | r));
    return ((r ^ (r >>> 14)) >>> 0) / 4294967296;
  };
}
function seedFromString(s){
  let h = 2166136261 >>> 0;
  for(let i=0;i<s.length;i++){
    h ^= s.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}

/* ============================================================
 * 3. KHUNG BAO AN TOÀN
 * ============================================================ */
function safeRadius(a,b){
  const q = CFG.q;
  const ts = [[a,0],[0,-0.5],[0.5,-0.5],[0.5+b,-1]];
  let B = 0;
  for(const t of ts){ B = Math.max(B, Math.hypot(t[0],t[1])); }
  const R = Math.max(Math.SQRT2, B/(1-q));
  return R;
}

/* ============================================================
 * 4. WEB WORKER (tạo từ Blob)
 * ============================================================ */
const WORKER_SRC = `
self.onmessage = function(ev){
  const msg = ev.data;
  if(msg.type === 'chaos'){
    const {taskId, alpha, beta, seed, N, skip} = msg;
    let t = seed >>> 0;
    function rnd(){
      t = (t + 0x6D2B79F5) >>> 0;
      let r = t;
      r = Math.imul(r ^ (r >>> 15), 1 | t);
      r = r ^ (r + Math.imul(r ^ (r >>> 7), 61 | r));
      return ((r ^ (r >>> 14)) >>> 0) / 4294967296;
    }
    let x=0, y=0;
    const CHUNK = 20000;
    let produced = 0;
    for(let k=0;k<skip;k++){
      const i = (rnd()*4)|0;
      let nx, ny;
      if(i===0){ nx = -(x+y)/2 + alpha; ny = y/2; }
      else if(i===1){ nx = -(x+y)/2; ny = y/2 - 0.5; }
      else if(i===2){ nx = -(x+y)/2 + 0.5; ny = y/2 - 0.5; }
      else { nx = (x+y)/2 + 0.5 + beta; ny = -y/2 - 1; }
      x = nx; y = ny;
    }
    function step(){
      const end = Math.min(produced + CHUNK, N);
      const buf = new Float32Array((end-produced)*3);
      let k = 0;
      while(produced < end){
        const i = (rnd()*4)|0;
        let nx, ny;
        if(i===0){ nx = -(x+y)/2 + alpha; ny = y/2; }
        else if(i===1){ nx = -(x+y)/2; ny = y/2 - 0.5; }
        else if(i===2){ nx = -(x+y)/2 + 0.5; ny = y/2 - 0.5; }
        else { nx = (x+y)/2 + 0.5 + beta; ny = -y/2 - 1; }
        x = nx; y = ny;
        buf[k++] = x; buf[k++] = y; buf[k++] = i+1;
        produced++;
      }
      self.postMessage({type:'chunk', taskId, buf: buf.buffer}, [buf.buffer]);
      if(produced < N){
        setTimeout(step, 0);
      } else {
        self.postMessage({type:'done', taskId});
      }
    }
    step();
  }
};
`;
let worker = null;
function getWorker(){
  if(worker) return worker;
  const blob = new Blob([WORKER_SRC], {type:'application/javascript'});
  worker = new Worker(URL.createObjectURL(blob));
  return worker;
}

/* ============================================================
 * 5. CANVAS & BIẾN ĐỔI TỌA ĐỘ
 * ============================================================ */
const cv = document.getElementById('cv');
const ctx = cv.getContext('2d');
let DPR = Math.max(1, window.devicePixelRatio || 1);
let W=0, H=0;

function resizeCanvas(){
  const wrap = document.getElementById('canvasWrap');
  const rect = wrap.getBoundingClientRect();
  W = Math.max(1, Math.floor(rect.width));
  H = Math.max(1, Math.floor(rect.height));
  cv.width = Math.floor(W*DPR);
  cv.height = Math.floor(H*DPR);
  cv.style.width = W+'px';
  cv.style.height = H+'px';
  ctx.setTransform(DPR,0,0,DPR,0,0);
  redraw();
}

function worldToScreen(x,y){
  return [ (x - STATE.view.cx)*STATE.view.scale + W/2,
           H/2 - (y - STATE.view.cy)*STATE.view.scale ];
}
function screenToWorld(sx,sy){
  return [ (sx - W/2)/STATE.view.scale + STATE.view.cx,
           STATE.view.cy - (sy - H/2)/STATE.view.scale ];
}

/* ============================================================
 * 6. VẼ LƯỚI / TRỤC / TAM GIÁC GỐC
 * ============================================================ */
function niceStep(rangePix, targetPx=80){
  const rawRange = rangePix;
  const target = targetPx / STATE.view.scale;
  const pow = Math.pow(10, Math.floor(Math.log10(target)));
  const n = target/pow;
  let step;
  if(n < 1.5) step = 1*pow;
  else if(n < 3.5) step = 2*pow;
  else if(n < 7.5) step = 5*pow;
  else step = 10*pow;
  return step;
}

function drawGridAndAxes(){
  const [xmin, ymax] = screenToWorld(0,0);
  const [xmax, ymin] = screenToWorld(W,H);
  const step = niceStep(Math.max(xmax-xmin, ymax-ymin));

  if(STATE.showGrid){
    ctx.strokeStyle = '#1e2533';
    ctx.lineWidth = 1;
    ctx.beginPath();
    let x0 = Math.floor(xmin/step)*step;
    for(let x=x0; x<=xmax; x+=step){
      const [sx] = worldToScreen(x,0);
      ctx.moveTo(sx,0); ctx.lineTo(sx,H);
    }
    let y0 = Math.floor(ymin/step)*step;
    for(let y=y0; y<=ymax; y+=step){
      const [,sy] = worldToScreen(0,y);
      ctx.moveTo(0,sy); ctx.lineTo(W,sy);
    }
    ctx.stroke();
  }

  if(STATE.showAxes){
    ctx.strokeStyle = '#3a455c';
    ctx.lineWidth = 1;
    ctx.beginPath();
    const [,sy0] = worldToScreen(0,0);
    const [sx0] = worldToScreen(0,0);
    ctx.moveTo(0,sy0); ctx.lineTo(W,sy0);
    ctx.moveTo(sx0,0); ctx.lineTo(sx0,H);
    ctx.stroke();

    ctx.fillStyle = '#8892a6';
    ctx.font = '11px system-ui';
    ctx.textAlign='center'; ctx.textBaseline='top';
    let x0 = Math.floor(xmin/step)*step;
    for(let x=x0; x<=xmax; x+=step){
      if(Math.abs(x)<step*0.01) continue;
      const [sx] = worldToScreen(x,0);
      const [,sy] = worldToScreen(0,0);
      ctx.fillText(formatNum(x), sx, Math.min(H-14, Math.max(2, sy+3)));
    }
    ctx.textAlign='right'; ctx.textBaseline='middle';
    let y0 = Math.floor(ymin/step)*step;
    for(let y=y0; y<=ymax; y+=step){
      if(Math.abs(y)<step*0.01) continue;
      const [sx] = worldToScreen(0,0);
      const [,sy] = worldToScreen(0,y);
      ctx.fillText(formatNum(y), Math.max(26, Math.min(W-4, sx-4)), sy);
    }
  }
}

function formatNum(v){
  if(Math.abs(v) < 1e-12) return '0';
  if(Math.abs(v) >= 1000 || Math.abs(v) < 0.01) return v.toExponential(1);
  let s = v.toFixed(3);
  s = s.replace(/\.?0+$/,'');
  return s;
}

function drawOriginalTriangle(){
  if(!STATE.showOrig) return;
  const O=CFG.O, A=CFG.A, B=CFG.B;
  const [x0,y0]=worldToScreen(O[0],O[1]);
  const [x1,y1]=worldToScreen(A[0],A[1]);
  const [x2,y2]=worldToScreen(B[0],B[1]);
  ctx.save();
  ctx.setLineDash([5,4]);
  ctx.strokeStyle = '#8892a6';
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.moveTo(x0,y0); ctx.lineTo(x1,y1); ctx.lineTo(x2,y2); ctx.closePath();
  ctx.stroke();
  ctx.setLineDash([]);
  ctx.fillStyle = '#c9d4e6';
  ctx.font = '12px system-ui';
  ctx.textAlign='center'; ctx.textBaseline='middle';
  ctx.fillText('O', x0-10, y0-10);
  ctx.fillText('A', x1+10, y1+10);
  ctx.fillText('B', x2-10, y2+10);
  ctx.restore();
}

/* ============================================================
 * 7. VẼ CHAOS GAME
 * ============================================================ */
function drawChaos(){
  const d = STATE.chaosData;
  if(!d) return;
  const mono = document.getElementById('cmMono').checked;
  const color = mono ? CFG.mono : null;
  const img = ctx.createImageData(cv.width, cv.height);
  const data = img.data;
  const scale = STATE.view.scale;
  const cx = STATE.view.cx, cy = STATE.view.cy;
  const pts = d.points;
  const n = pts.length;
  for(let k=0;k<n;k++){
    const x = pts[k*3], y = pts[k*3+1], m = pts[k*3+2];
    const sx = (x - cx)*scale + W/2;
    const sy = H/2 - (y - cy)*scale;
    const ix = (sx*DPR)|0;
    const iy = (sy*DPR)|0;
    if(ix<0||iy<0||ix>=cv.width||iy>=cv.height) continue;
    const idx = (iy*cv.width + ix)*4;
    let r,g,b;
    if(mono){ r=201; g=212; b=230; }
    else {
      const c = CFG.colors[m];
      r = parseInt(c.slice(1,3),16);
      g = parseInt(c.slice(3,5),16);
      b = parseInt(c.slice(5,7),16);
    }
    data[idx]   = Math.min(255, data[idx]   + (r*0.35|0));
    data[idx+1] = Math.min(255, data[idx+1] + (g*0.35|0));
    data[idx+2] = Math.min(255, data[idx+2] + (b*0.35|0));
    data[idx+3] = 255;
  }
  ctx.putImageData(img, 0, 0);
}

/* ============================================================
 * 8. VẼ TAM GIÁC
 * ============================================================ */
function drawTriangles(){
  const d = STATE.triData;
  if(!d) return;
  const tris = d.triangles;
  const stroke = STATE.showStroke || d.level<=2;
  const buckets = {1:[],2:[],3:[],4:[]};
  for(const t of tris) buckets[t.outer].push(t);

  for(const m of [1,2,3,4]){
    ctx.fillStyle = CFG.colors[m];
    ctx.beginPath();
    for(const t of buckets[m]){
      const [x0,y0] = worldToScreen(t.v[0][0], t.v[0][1]);
      const [x1,y1] = worldToScreen(t.v[1][0], t.v[1][1]);
      const [x2,y2] = worldToScreen(t.v[2][0], t.v[2][1]);
      ctx.moveTo(x0,y0); ctx.lineTo(x1,y1); ctx.lineTo(x2,y2); ctx.closePath();
    }
    ctx.fill('evenodd');
    if(stroke){
      ctx.strokeStyle = 'rgba(10,12,16,0.6)';
      ctx.lineWidth = 1;
      ctx.stroke();
    }
  }

  if(STATE.selectedPiece){
    const t = tris.find(x=>x.a===STATE.selectedPiece);
    if(t){
      ctx.save();
      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 2;
      ctx.setLineDash([4,3]);
      const [x0,y0] = worldToScreen(t.v[0][0], t.v[0][1]);
      const [x1,y1] = worldToScreen(t.v[1][0], t.v[1][1]);
      const [x2,y2] = worldToScreen(t.v[2][0], t.v[2][1]);
      ctx.beginPath();
      ctx.moveTo(x0,y0); ctx.lineTo(x1,y1); ctx.lineTo(x2,y2); ctx.closePath();
      ctx.stroke();
      ctx.restore();
    }
  }

  drawLabels();
}

/* ============================================================
 * 9. NHÃN ĐỊA CHỈ
 * ============================================================ */
function drawLabels(){
  if(!STATE.showLabels) return;
  if(STATE.mode !== 'tri' || !STATE.triData) return;
  const tris = STATE.triData.triangles;
  const size = STATE.labelSize;
  ctx.font = `${size}px ui-monospace,Menlo,Consolas,monospace`;
  ctx.textAlign='center'; ctx.textBaseline='middle';

  let drawn = 0, total = tris.length;
  const charW = size*0.62;

  for(const t of tris){
    const gx = (t.v[0][0]+t.v[1][0]+t.v[2][0])/3;
    const gy = (t.v[0][1]+t.v[1][1]+t.v[2][1])/3;
    const [sx,sy] = worldToScreen(gx,gy);
    if(sx<-50||sy<-50||sx>W+50||sy>H+50) continue;

    const p0 = worldToScreen(t.v[0][0],t.v[0][1]);
    const p1 = worldToScreen(t.v[1][0],t.v[1][1]);
    const p2 = worldToScreen(t.v[2][0],t.v[2][1]);
    const L0 = Math.hypot(p1[0]-p0[0], p1[1]-p0[1]);
    const L1 = Math.hypot(p2[0]-p1[0], p2[1]-p1[1]);
    const L2 = Math.hypot(p0[0]-p2[0], p0[1]-p2[1]);
    const Lmax = Math.max(L0,L1,L2);
    const textW = t.a.length * charW + 4;

    if(STATE.autoHideLabels && (Lmax < textW*1.1 || Lmax < 10)) continue;

    ctx.fillStyle = 'rgba(10,12,16,0.55)';
    ctx.fillRect(sx-textW/2, sy-size/2-1, textW, size+2);
    ctx.fillStyle = '#ffffff';
    ctx.fillText(t.a, sx, sy);
    drawn++;
  }
  document.getElementById('labelStats').textContent = `Nhãn: ${drawn}/${total}`;
}

/* ============================================================
 * 10. VẼ CẶP ĐIỂM TIẾP XÚC (MỚI)
 * ============================================================ */
function drawContactPoints(){
  if(!STATE.showContact) return;
  
  // Chỉ vẽ nếu có hình đã vẽ với bộ tham số hiện tại
  const hasImage = (STATE.mode==='chaos' && STATE.chaosData && 
                    STATE.chaosData.alpha===STATE.alpha && 
                    STATE.chaosData.beta===STATE.beta) ||
                   (STATE.mode==='tri' && STATE.triData &&
                    STATE.triData.alpha===STATE.alpha &&
                    STATE.triData.beta===STATE.beta);
  
  if(!hasImage) return;

  const a = STATE.alpha, b = STATE.beta;
  
  // fix1 = điểm cố định của f2∘f3 = (0, -1)
  const fix1 = [0, -1];
  
  // fix2 = điểm cố định của f1 = (2α/3, 0)
  const fix2 = [2*a/3, 0];
  
  // U = f4(fix1) = (β, -1/2)
  const U = MAPS[4](fix1[0], fix1[1], a, b);
  
  // V = f2(fix2) = (-α/3, -1/2)
  const V = MAPS[2](fix2[0], fix2[1], a, b);
  
  const [ux, uy] = worldToScreen(U[0], U[1]);
  const [vx, vy] = worldToScreen(V[0], V[1]);
  
  const delta = b + a/3;
  const dist = Math.abs(delta);
  
  // Vẽ đoạn nối nếu khác nhau
  if(dist > 1e-10){
    ctx.save();
    ctx.strokeStyle = '#ff6b6b';
    ctx.lineWidth = 1.5;
    ctx.setLineDash([4,3]);
    ctx.beginPath();
    ctx.moveTo(ux, uy);
    ctx.lineTo(vx, vy);
    ctx.stroke();
    ctx.restore();
  }
  
  // Vẽ điểm U
  ctx.save();
  ctx.fillStyle = '#ff6b6b';
  ctx.strokeStyle = '#ffffff';
  ctx.lineWidth = 2;
  ctx.beginPath();
  ctx.arc(ux, uy, 6, 0, 2*Math.PI);
  ctx.fill();
  ctx.stroke();
  
  // Nhãn U
  ctx.fillStyle = '#ffffff';
  ctx.font = 'bold 12px system-ui';
  ctx.textAlign = 'left';
  ctx.textBaseline = 'middle';
  ctx.fillText('U: 4(23)∞', ux+10, uy);
  ctx.restore();
  
  // Vẽ điểm V (nếu khác U)
  if(dist > 1e-10){
    ctx.save();
    ctx.fillStyle = '#4dd0e1';
    ctx.strokeStyle = '#ffffff';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(vx, vy, 6, 0, 2*Math.PI);
    ctx.fill();
    ctx.stroke();
    
    // Nhãn V
    ctx.fillStyle = '#ffffff';
    ctx.font = 'bold 12px system-ui';
    ctx.textAlign = 'left';
    ctx.textBaseline = 'middle';
    ctx.fillText('V: 21∞', vx+10, vy);
    ctx.restore();
  } else {
    // Nếu trùng nhau, vẽ nhãn kép
    ctx.save();
    ctx.fillStyle = '#ffffff';
    ctx.font = 'bold 12px system-ui';
    ctx.textAlign = 'left';
    ctx.textBaseline = 'middle';
    ctx.fillText('U=V: 4(23)∞ = 21∞', ux+10, uy);
    ctx.restore();
  }
  
  // Hiển thị thông tin δ và khoảng cách
  ctx.save();
  ctx.fillStyle = 'rgba(20,24,32,0.9)';
  ctx.fillRect(10, 10, 200, 40);
  ctx.strokeStyle = '#2a3040';
  ctx.lineWidth = 1;
  ctx.strokeRect(10, 10, 200, 40);
  
  ctx.fillStyle = '#e7ecf3';
  ctx.font = '11px system-ui';
  ctx.textAlign = 'left';
  ctx.textBaseline = 'top';
  ctx.fillText(`δ = β + α/3 = ${delta.toFixed(9)}`, 15, 15);
  ctx.fillText(`||U−V|| = |δ| = ${dist.toFixed(9)}`, 15, 30);
  ctx.restore();
}

/* ============================================================
 * 11. REDRAW TỔNG HỢP
 * ============================================================ */
function redraw(){
  ctx.clearRect(0,0,W,H);
  ctx.fillStyle = '#0a0c10';
  ctx.fillRect(0,0,W,H);
  drawGridAndAxes();
  drawOriginalTriangle();
  if(STATE.mode==='chaos') drawChaos();
  else drawTriangles();
  drawContactPoints(); // MỚI
}

/* ============================================================
 * 12. ĐIỀU KHIỂN CHAOS GAME
 * ============================================================ */
function startChaos(){
  cancelAllTasks();
  const taskId = ++STATE.taskId;
  const N = parseInt(document.getElementById('numPts').value,10);
  const seedStr = document.getElementById('seed').value.trim() || '0';
  const seed = seedFromString(seedStr);
  const alpha = STATE.alpha, beta = STATE.beta;
  const skip = 200;

  showProgress(true, `Đang tính ${N.toLocaleString('vi-VN')} điểm…`);
  const t0 = performance.now();

  const w = getWorker();
  let produced = 0;
  const bufAll = new Float32Array(N*3);

  w.onmessage = (ev)=>{
    const m = ev.data;
    if(m.taskId !== taskId) return;
    if(m.type==='chunk'){
      const arr = new Float32Array(m.buf);
      bufAll.set(arr, produced*3);
      produced += arr.length/3;
      updateProgress(produced/N, `${produced.toLocaleString('vi-VN')} / ${N.toLocaleString('vi-VN')}`);
      if(produced % 80000 < arr.length/3){
        STATE.chaosData = {points: bufAll.slice(0, produced*3), alpha, beta, seed, n:produced};
        redraw();
      }
    } else if(m.type==='done'){
      STATE.chaosData = {points: bufAll, alpha, beta, seed, n:N};
      const dt = ((performance.now()-t0)/1000).toFixed(2);
      hideProgress();
      updateStatus();
      redraw();
      console.log(`Chaos done in ${dt}s`);
    }
  };
  w.postMessage({type:'chaos', taskId, alpha, beta, seed, N, skip});
}

/* ============================================================
 * 13. XẤP XỈ TAM GIÁC
 * ============================================================ */
function buildLevel(level){
  const a = STATE.alpha, b = STATE.beta;
  let cur = [{ v:[CFG.O.slice(), CFG.A.slice(), CFG.B.slice()], a:'', outer:0 }];
  for(let lv=1; lv<=level; lv++){
    const next = [];
    for(const t of cur){
      for(let i=1;i<=4;i++){
        next.push(applyMapToTri(i, t, a, b));
      }
    }
    cur = next;
  }
  return { level, triangles: cur, alpha:a, beta:b };
}

function setLevel(level){
  cancelAllTasks();
  const taskId = ++STATE.taskId;
  STATE.triData = buildLevel(level);
  document.getElementById('level').value = level;
  document.getElementById('levelNum').value = level;
  document.getElementById('triCount').textContent =
    `Số tam giác: ${STATE.triData.triangles.length.toLocaleString('vi-VN')}`;
  updateStatus();
  redraw();
}

